import "./style.css";
import { redirect, ValidationError } from "@elements/app";
import type { File, Listener } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Alert } from "@elements/ui/alert";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardHeader, CardTitle, CardFooter } from "@elements/ui/card";
import { Checkbox, CheckboxGroup } from "@elements/ui/checkbox";
import { DatePicker } from "@elements/ui/date-picker";
import { Empty } from "@elements/ui/empty";
import { Field } from "@elements/ui/field";
import { Icon } from "@elements/ui/icon";
import { Input } from "@elements/ui/input";
import { NativeSelect } from "@elements/ui/native-select";
import { Textarea } from "@elements/ui/textarea";
import { Layout } from "#app/shared/templates/layout";
import { CurrentUser } from "#app/shared/services/auth";
import { ReportSummary, Expense } from "#app/shared/services/reports";
import { addExpense, deleteExpense, createReport, ExpenseForm, ExpenseErrors } from "#app/shared/services/workflow";
import {
  CATEGORIES,
  CATEGORY_LABELS,
  STATUS_LABELS,
  statusVariant,
  formatMoney,
  formatDay,
  formatWhen,
  plural,
} from "#app/shared/format";

export interface HomeState {
  reports: ReportSummary[];
  unfiled: Expense[];
  flashId: string;
}

interface AddState {
  form: ExpenseForm;
  errors: ExpenseErrors;
  error: string;
  receipt: File[];
  busy: boolean;
}

interface GroupState {
  ids: string[];
  title: string;
  error: string;
}

function blankExpense(spentOn: string): ExpenseForm {
  return { spentOn, merchant: "", amount: "", category: "meals", note: "", receipt: null };
}

function onReportUpdate(state: HomeState, report: ReportSummary) {
  let index = state.reports.findIndex((r) => r.id === report.id);

  if (index === -1) {
    state.reports.unshift(report);
  } else {
    state.reports[index] = report;
  }

  state.flashId = report.id;
}

function onAdd(add: AddState, state: HomeState) {
  add.busy = true;

  try {
    state.unfiled = addExpense({ ...add.form, receipt: add.receipt[0] ?? null });
    add.form = blankExpense(add.form.spentOn);
    add.receipt = [];
    add.errors = {};
    add.error = "";
  } catch (err: any) {
    if (err instanceof ValidationError && err.errors) {
      add.errors = err.errors;
      add.error = "";
    } else {
      add.errors = {};
      add.error = err.message;
    }
  }

  add.busy = false;
}

function onDelete(state: HomeState, group: GroupState, expense: Expense) {
  state.unfiled = deleteExpense(expense.id);
  group.ids = group.ids.filter((id) => id !== expense.id);
}

function onGroup(group: GroupState) {
  try {
    let id = createReport(group.title, group.ids);
    redirect(`/reports/${id}`);
  } catch (err: any) {
    group.error = err.message;
  }
}

const CATEGORY_OPTIONS = CATEGORIES.map((c) => ({ value: c, label: CATEGORY_LABELS[c] }));

function pendingCents(reports: ReportSummary[]): number {
  return reports.filter((r) => r.status === "submitted").reduce((sum, r) => sum + r.totalCents, 0);
}

function approvedThisMonthCents(reports: ReportSummary[]): number {
  let now = new Date();

  return reports
    .filter((r) => r.status === "approved" && r.decidedAt && r.decidedAt.getMonth() === now.getMonth() && r.decidedAt.getFullYear() === now.getFullYear())
    .reduce((sum, r) => sum + r.totalCents, 0);
}

function pickedCents(unfiled: Expense[], ids: string[]): number {
  return unfiled.filter((e) => ids.includes(e.id)).reduce((sum, e) => sum + e.amountCents, 0);
}

function reportMeta(report: ReportSummary): string {
  let when = report.status === "draft"
    ? `Started ${formatWhen(report.createdAt)}`
    : report.status === "submitted"
      ? `Submitted ${formatWhen(report.submittedAt)}`
      : `${report.status === "approved" ? "Approved" : "Sent back"} ${formatWhen(report.decidedAt)}`;

  return `${plural(report.expenseCount, "expense")} · ${when}`;
}

<html lang="en" class="page-home" (
  user: CurrentUser,
  today: string,
  initial: HomeState,
  updates: Listener<ReportSummary>,
  private state: HomeState = initial,
  private add: AddState = { form: blankExpense(today), errors: {}, error: "", receipt: [], busy: false },
  private group: GroupState = { ids: [], title: "", error: "" },
) oninit={() => updates.on("notify", (report) => onReportUpdate(state, report))}>
  <head>
    <title>My expenses · slipjar</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout {user} active="expenses">
      <div class="home-head row">
        <div class="stack is-xs">
          <h1>My expenses</h1>
          <p class="lede">Add receipts as you go, then group them into a report.</p>
        </div>

        <div class="home-stats row">
          <div class="home-stat">
            <span class="home-stat-label">Awaiting approval</span>
            <span class="home-stat-value">{formatMoney(pendingCents(state.reports))}</span>
          </div>
          <div class="home-stat">
            <span class="home-stat-label">Approved this month</span>
            <span class="home-stat-value">{formatMoney(approvedThisMonthCents(state.reports))}</span>
          </div>
        </div>
      </div>

      <div class="home-grid">
        <section class="home-add" aria-labelledby="add-title">
          <Card>
            <CardHeader>
              <CardTitle level={2} id="add-title">Add an expense</CardTitle>
            </CardHeader>

            <form class="add-form card-body stack" onsubmit={() => onAdd(add, state)}>
              <Alert e:if={add.error} variant="danger" description={add.error} />

              <div class="amount-row">
                <Field label="Date" error={add.errors.spentOn?.[0] ?? ""} reserveError={false}>
                  <DatePicker value={add.form.spentOn} max={today} block format={{ dateStyle: "medium" }}
                              invalid={!!add.errors.spentOn} required />
                </Field>

                <Field label="Amount" error={add.errors.amount?.[0] ?? ""} reserveError={false}>
                  <Input value={add.form.amount} placeholder="0.00" invalid={!!add.errors.amount}
                         attrs={{ inputmode: "decimal", autocomplete: "off" }} required />
                </Field>
              </div>

              <Field label="Merchant" error={add.errors.merchant?.[0] ?? ""} reserveError={false}>
                <Input value={add.form.merchant} placeholder="Where you paid" invalid={!!add.errors.merchant}
                       attrs={{ autocomplete: "off" }} required />
              </Field>

              <Field label="Category" reserveError={false}>
                <NativeSelect value={add.form.category} options={CATEGORY_OPTIONS} block />
              </Field>

              <Field label="Note" reserveError={false}>
                <Textarea value={add.form.note} rows={2} placeholder="Who was there, what it was for" />
              </Field>

              <Field label="Receipt photo" description="JPEG, PNG or WebP, up to 8 MB."
                     error={add.errors.receipt?.[0] ?? ""} reserveError={false}>
                <Input type="file" files={add.receipt} invalid={!!add.errors.receipt}
                       attrs={{ accept: "image/png,image/jpeg,image/webp,image/gif" }} />
              </Field>

              <Button type="submit" variant="primary" block loading={add.busy}>Add expense</Button>
            </form>
          </Card>
        </section>

        <section class="home-unfiled" aria-labelledby="unfiled-title">
          <Card>
            <CardHeader>
              <CardTitle level={2} id="unfiled-title">Not on a report yet<span class="count">{state.unfiled.length}</span></CardTitle>
            </CardHeader>

            <Empty e:if={state.unfiled.length === 0} description="Every expense is on a report. New ones land here." />

            <CheckboxGroup e:else value={group.ids}>
              <ul class="list">
                <li e:for={e of state.unfiled} class={["expense-row", group.ids.includes(e.id) && "is-picked"]}>
                  <label class="expense-pick"><Checkbox value={e.id} attrs={{ "aria-label": `Select ${e.merchant}` }} /></label>
                  <a e:if={e.receiptUrl} href={e.receiptUrl} target="_blank" rel="noopener">
                    <img class="thumb" src={e.receiptUrl} alt={`Receipt from ${e.merchant}`} width="40" height="40">
                  </a>
                  <span e:else class="thumb"></span>
                  <div class="expense-text">
                    <span class="expense-merchant truncate">{e.merchant}</span>
                    <span class="expense-meta truncate">{formatDay(e.spentOn)} · {CATEGORY_LABELS[e.category]}{e.note ? ` · ${e.note}` : ""}</span>
                  </div>
                  <span class="money">{formatMoney(e.amountCents)}</span>
                  <Button class="remove" variant="ghost" size="sm" icon label={`Delete ${e.merchant}`}
                          onclick={() => onDelete(state, group, e)}>
                    <Icon name="x" />
                  </Button>
                </li>
              </ul>
            </CheckboxGroup>

            <CardFooter e:if={state.unfiled.length > 0}>
              <form class="group-form" onsubmit={() => onGroup(group)}>
                <Input value={group.title} placeholder={group.ids.length === 0 ? "Select expenses, then name the report" : `Name this report (${plural(group.ids.length, "expense")}, ${formatMoney(pickedCents(state.unfiled, group.ids))})`}
                       attrs={{ "aria-label": "Report name" }} />
                <Button type="submit" variant="primary" disabled={group.ids.length === 0 || !group.title.trim()}>Create report</Button>
              </form>
              <Alert e:if={group.error} variant="danger" class="group-error" description={group.error} />
            </CardFooter>
          </Card>
        </section>

        <section class="home-reports" aria-labelledby="reports-title">
          <Card>
            <CardHeader>
              <CardTitle level={2} id="reports-title">Reports<span class="count">{state.reports.length}</span></CardTitle>
            </CardHeader>

            <Empty e:if={state.reports.length === 0} description="No reports yet. Select expenses above to start one." />

            <ul e:else class="list">
              <li e:for={r of state.reports} class={[state.flashId === r.id && "is-flash"]}>
                <a class="report-row" href={`/reports/${r.id}`}>
                  <div class="stack is-xs">
                    <span class="report-title">{r.title}</span>
                    <span class="report-meta">{reportMeta(r)}</span>
                  </div>
                  <div class="report-side">
                    <span class="money">{formatMoney(r.totalCents)}</span>
                    <Badge variant={statusVariant(r.status)} dot>{STATUS_LABELS[r.status]}</Badge>
                  </div>
                  <p e:if={r.decisionComment} class={["report-comment", r.status === "approved" && "is-approved"]}>
                    “{r.decisionComment}” <cite>{r.deciderName}</cite>
                  </p>
                </a>
              </li>
            </ul>
          </Card>
        </section>
      </div>
    </Layout>
  </body>
</html>
