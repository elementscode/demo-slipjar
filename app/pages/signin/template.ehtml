import "./style.css";
import { redirect } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Alert } from "@elements/ui/alert";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardFooter } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { signin, SigninForm } from "#app/shared/services/auth";

export interface DemoLogin {
  id: string;
  name: string;
  email: string;
  role: "employee" | "approver";
}

export const DEMO_PASSWORD = "receipts";

function onSubmit(form: SigninForm) {
  try {
    signin(form);
    form.error = "";
    redirect("/");
  } catch (err: any) {
    form.error = err.message;
  }
}

function onPick(form: SigninForm, login: DemoLogin) {
  form.email = login.email;
  form.password = DEMO_PASSWORD;
  onSubmit(form);
}

<html lang="en" class="page-signin" (
  demoLogins: DemoLogin[],
  private form: SigninForm = { email: "", password: "", error: "" },
)>
  <head>
    <title>Sign in · slipjar</title>
    <meta name="description" content="Expense reports for the team.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <main class="signin-main center">
      <div class="signin-grid">
        <form class="signin-form stack is-lg" onsubmit={() => onSubmit(form)}>
          <div class="signin-brand row">
            <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M5 2.5h14v19l-2.33-1.5-2.34 1.5L12 20l-2.33 1.5L7.33 20 5 21.5z" fill="currentColor"/>
              <path d="M8.5 8h7M8.5 11.5h7M8.5 15h4" stroke="var(--bg)" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
            <span>slipjar</span>
          </div>

          <div class="stack is-xs">
            <h1>Sign in</h1>
            <p class="lede">Log expenses, send reports, get paid back.</p>
          </div>

          <Alert e:if={form.error} variant="danger" description={form.error} />

          <div class="stack">
            <Field label="Work email" reserveError={false}>
              <Input type="email" name="email" value={form.email} placeholder="you@company.com" required
                     attrs={{ id: "email", autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
            </Field>

            <Field label="Password" reserveError={false}>
              <Input type="password" name="password" value={form.password} required
                     attrs={{ id: "password", autocomplete: "current-password" }} />
            </Field>
          </div>

          <Button type="submit" variant="primary" block>Sign in</Button>
        </form>

        <Card e:if={demoLogins.length > 0} title="Demo accounts" level={2} attrs={{ role: "region", "aria-label": "Demo accounts" }}>

          <ul class="demo-list">
            <li e:for={login of demoLogins}>
              <button type="button" class="demo-login" onclick={() => onPick(form, login)}>
                <span class="demo-name">{login.name}</span>
                <span class="demo-email">{login.email}</span>
                <Badge e:if={login.role === "approver"} variant="accent">Approver</Badge>
                <Badge e:else variant="secondary">Employee</Badge>
              </button>
            </li>
          </ul>

          <CardFooter align="start">
            <p class="demo-password">Click one to sign in. Every password is <code>{DEMO_PASSWORD}</code>.</p>
          </CardFooter>
        </Card>
      </div>
    </main>
  </body>
</html>
